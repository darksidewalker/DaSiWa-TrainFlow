# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/
bin/
lib/
python_embeded/

# TrainFlow generated files
*.safetensors
*.ckpt
*.state/
*.pth
*.onnx
*-state/
training/output/
training/logs/
training/settings.json
training/prepared/
training/musubi-tuner/.venv/
training/musubi-tuner/venv/
training/musubi-tuner/datasets/
training/musubi-tuner/output/
training/musubi-tuner/outputs/
training/musubi-tuner/logs/
models/*

# Lowercase build artifacts (canonical binaries are TrainFlow, TrainFlow_Runtime_Tool)
trainflow
runtime-tool
!models/.gitkeep

# Distribution / packaging
dist/
dist/
build/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
*.log
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints

# Local environment files (secrets)
.env
.env.docker

# Hugging Face and other caches
# Note: huggingface_hub often uses .cache/huggingface for local metadata
.cache/

# Frontend (useful if you are developing custom Gradio components)
node_modules/

# OS generated files
.DS_Store
Thumbs.db
*.swp

# Hermes Agent local state
.hermes/

# Runtime update temp folder
.runtime-update/

# Runtime backups (timestamped)
python_embeded_*_backup*/
